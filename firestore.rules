rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Schedule items are publicly readable by all students and lecturers
    match /schedules/{scheduleId} {
      allow read, write: if true;
    }
    
    // Faculty directory
    match /faculty/{facultyId} {
      allow read, write: if true;
    }

    // App settings (departments list, configs)
    match /app_settings/{docId} {
      allow read, write: if true;
    }

    // Connectivity test
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
